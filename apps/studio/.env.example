DATABASE_URL=postgres://user:pass@host/db?sslmode=require
BLOB_READ_WRITE_TOKEN=
# http 데이터셋이 호출할 수 있는 호스트. host[:port][=비밀값이름|비밀값이름]. 비밀값은 이름이 묶인 호스트로만 보낸다
DAPORT_HTTP_ALLOW=mes.example.com=MES_TOKEN,api.local:8080
DAPORT_SECRET_MES_TOKEN=
DAPORT_PRINTERS=라인1=192.168.10.21:9100,포장=192.168.10.22
# 렌더 중 Chromium이 요청할 수 있는 외부 호스트(host[:port], 쉼표). 비면 자기 origin 밖은 전부 차단. 예: cdn.example.com
DAPORT_RENDER_ALLOW=
# MES 프론트가 브라우저에서 render/published를 부를 때 허용할 origin(쉼표)
DAPORT_CORS_ORIGINS=https://mes.example.com
# DATABASE_URL이 없는 dev·E2E에서만 인정하는 전체 허용 API 키. 운영에서는 pnpm --filter studio keys create
DAPORT_DEV_API_KEY=
# Oracle 연결의 비밀값. 연결 화면의 "비밀값 이름"과 맞춘다 (direct: 비밀번호, agent: 에이전트 토큰)
DAPORT_SECRET_MES_DB_PASSWORD=
DAPORT_SECRET_FACTORY_AGENT_TOKEN=
