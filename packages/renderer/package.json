{
  "name": "@daport/renderer",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./layout": "./src/layout/layout.ts", "./paint": "./src/paint/index.ts", "./fonts/*": "./fonts/*" },
  "imports": { "#markup": { "react-server": "./src/markup.react-server.ts", "default": "./src/markup.ts" } },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:metrics": "tsx scripts/gen-metrics.ts"
  },
  "dependencies": {
    "@daport/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "opentype.js": "1.3.4",
    "@types/opentype.js": "^1.3.8",
    "tsx": "^4.19.0"
  }
}
